# Copy this file to .private and edit the values to match your configuration

# Windows folder where is installed DCS-BIOS Skunkworks SOCAT binary
export DCS_BIOS_FOLDER=""

# Target folder for build/dist
export DCS_BIOS_LAUNCHER_FOLDER=""

# Set this variable to --windowed if you want to build a windowed application (no console)
# or leave it empty for a console application (useful for debugging)
# export PRODUCTION="--windowed"
export PRODUCTION=""
